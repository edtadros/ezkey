{
  "name": "ezkey-www",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "ezkey.app", "custom_domain": true },
    { "pattern": "www.ezkey.app", "custom_domain": true }
  ]
}
